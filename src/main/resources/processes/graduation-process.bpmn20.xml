<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://graduation-process/bpmn">
  <!--
        Biến process cần truyền khi start:
          studentId  : username/id sinh viên (assignee các task của sinh viên)
          studentEmail: email nhận phản hồi
        Biến do task hoàn tất set:
          proposalApproved (boolean)  - task facultyReviewProposal
          feedback (string)           - task facultyReviewProposal
          plagiarismPassed (boolean)  - task plagiarismCheck
        candidateGroups: FACULTY (Khoa), COUNCIL (Hội đồng bảo vệ) -> map với Role.roleCode
    -->
  <process id="graduationProcess" name="Quy trình tốt nghiệp" isExecutable="true">
    <startEvent id="start" name="Bắt đầu"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="submitProposal"/>
    <!-- 1. Nộp đề cương qua biểu mẫu trực tuyến -->
    <userTask id="submitProposal" name="Sinh viên nộp đề cương" flowable:assignee="${studentId}"/>
    <sequenceFlow id="f2" sourceRef="submitProposal" targetRef="facultyReviewProposal"/>
    <!-- 2. Khoa kiểm duyệt -->
    <userTask id="facultyReviewProposal" name="Khoa kiểm duyệt đề cương" flowable:candidateGroups="FACULTY"/>
    <sequenceFlow id="f3" sourceRef="facultyReviewProposal" targetRef="proposalDecision"/>
    <exclusiveGateway id="proposalDecision" name="Đề cương đạt?" default="fProposalRejected"/>
    <sequenceFlow id="fProposalApproved" sourceRef="proposalDecision" targetRef="submitMidtermReport">
      <conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">${proposalApproved}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fProposalRejected" sourceRef="proposalDecision" targetRef="emailProposalFeedback"/>
    <!-- 3. Gửi phản hồi qua email, sinh viên chỉnh sửa và nộp lại -->
    <serviceTask id="emailProposalFeedback" name="Gửi email phản hồi đề cương" flowable:expression="${notificationService.sendFeedback(execution, 'PROPOSAL')}"/>
    <sequenceFlow id="f4" sourceRef="emailProposalFeedback" targetRef="reviseProposal"/>
    <userTask id="reviseProposal" name="Sinh viên chỉnh sửa và nộp lại đề cương" flowable:assignee="${studentId}"/>
    <sequenceFlow id="f5" sourceRef="reviseProposal" targetRef="facultyReviewProposal"/>
    <!-- 4. Báo cáo giữa kỳ -->
    <userTask id="submitMidtermReport" name="Sinh viên nộp báo cáo giữa kỳ" flowable:assignee="${studentId}"/>
    <sequenceFlow id="f6" sourceRef="submitMidtermReport" targetRef="submitFinalReport"/>
    <!-- 5. Nộp báo cáo cuối kỳ -->
    <userTask id="submitFinalReport" name="Sinh viên nộp báo cáo cuối kỳ" flowable:assignee="${studentId}"/>
    <sequenceFlow id="f7" sourceRef="submitFinalReport" targetRef="plagiarismCheck"/>
    <!-- 6. Kiểm tra trùng lặp -->
    <userTask id="plagiarismCheck" name="Kiểm tra trùng lặp" flowable:candidateGroups="FACULTY"/>
    <sequenceFlow id="f8" sourceRef="plagiarismCheck" targetRef="plagiarismDecision"/>
    <exclusiveGateway id="plagiarismDecision" name="Đạt kiểm tra trùng lặp?" default="fPlagiarismFailed"/>
    <sequenceFlow id="fPlagiarismPassed" sourceRef="plagiarismDecision" targetRef="defense">
      <conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">${plagiarismPassed}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fPlagiarismFailed" sourceRef="plagiarismDecision" targetRef="emailPlagiarismFeedback"/>
    <!-- 7. Chỉnh sửa báo cáo -->
    <serviceTask id="emailPlagiarismFeedback" name="Gửi email yêu cầu chỉnh sửa báo cáo" flowable:expression="${notificationService.sendFeedback(execution, 'FINAL_REPORT')}"/>
    <sequenceFlow id="f9" sourceRef="emailPlagiarismFeedback" targetRef="reviseFinalReport"/>
    <userTask id="reviseFinalReport" name="Sinh viên chỉnh sửa và nộp lại báo cáo cuối kỳ" flowable:assignee="${studentId}"/>
    <sequenceFlow id="f10" sourceRef="reviseFinalReport" targetRef="plagiarismCheck"/>
    <!-- 8. Bảo vệ -->
    <userTask id="defense" name="Bảo vệ trước hội đồng" flowable:candidateGroups="COUNCIL"/>
    <sequenceFlow id="f11" sourceRef="defense" targetRef="end"/>
    <endEvent id="end" name="Hoàn tất"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_graduationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_graduationProcess" bpmnElement="graduationProcess">
      <!-- Hàng chính (y tâm = 200) -->
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="start">
        <omgdc:Bounds x="290.0" y="167.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_submitProposal" bpmnElement="submitProposal">
        <omgdc:Bounds x="370.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_facultyReviewProposal" bpmnElement="facultyReviewProposal">
        <omgdc:Bounds x="530.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_proposalDecision" bpmnElement="proposalDecision" isMarkerVisible="true">
        <omgdc:Bounds x="690.0" y="160.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_submitMidtermReport" bpmnElement="submitMidtermReport">
        <omgdc:Bounds x="800.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_submitFinalReport" bpmnElement="submitFinalReport">
        <omgdc:Bounds x="960.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_plagiarismCheck" bpmnElement="plagiarismCheck">
        <omgdc:Bounds x="1120.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_plagiarismDecision" bpmnElement="plagiarismDecision" isMarkerVisible="true">
        <omgdc:Bounds x="1280.0" y="160.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_defense" bpmnElement="defense">
        <omgdc:Bounds x="1390.0" y="145.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="end">
        <omgdc:Bounds x="1540.0" y="167.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- Vòng lặp chỉnh sửa (y tâm = 340) -->
      <bpmndi:BPMNShape id="Shape_emailProposalFeedback" bpmnElement="emailProposalFeedback">
        <omgdc:Bounds x="665.0" y="285.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reviseProposal" bpmnElement="reviseProposal">
        <omgdc:Bounds x="530.0" y="285.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_emailPlagiarismFeedback" bpmnElement="emailPlagiarismFeedback">
        <omgdc:Bounds x="1255.0" y="285.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reviseFinalReport" bpmnElement="reviseFinalReport">
        <omgdc:Bounds x="1120.0" y="285.0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- Luồng -->
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1">
        <omgdi:waypoint x="326.0" y="185.0"/>
        <omgdi:waypoint x="370.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2">
        <omgdi:waypoint x="470.0" y="185.0"/>
        <omgdi:waypoint x="530.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f3" bpmnElement="f3">
        <omgdi:waypoint x="630.0" y="185.0"/>
        <omgdi:waypoint x="690.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fProposalApproved" bpmnElement="fProposalApproved">
        <omgdi:waypoint x="740.0" y="185.0"/>
        <omgdi:waypoint x="800.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fProposalRejected" bpmnElement="fProposalRejected">
        <omgdi:waypoint x="715.0" y="210.0"/>
        <omgdi:waypoint x="715.0" y="285.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f4" bpmnElement="f4">
        <omgdi:waypoint x="665.0" y="325.0"/>
        <omgdi:waypoint x="630.0" y="325.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f5" bpmnElement="f5">
        <omgdi:waypoint x="580.0" y="285.0"/>
        <omgdi:waypoint x="580.0" y="225.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f6" bpmnElement="f6">
        <omgdi:waypoint x="900.0" y="185.0"/>
        <omgdi:waypoint x="960.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f7" bpmnElement="f7">
        <omgdi:waypoint x="1060.0" y="185.0"/>
        <omgdi:waypoint x="1120.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f8" bpmnElement="f8">
        <omgdi:waypoint x="1220.0" y="185.0"/>
        <omgdi:waypoint x="1280.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fPlagiarismPassed" bpmnElement="fPlagiarismPassed">
        <omgdi:waypoint x="1330.0" y="185.0"/>
        <omgdi:waypoint x="1390.0" y="185.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fPlagiarismFailed" bpmnElement="fPlagiarismFailed">
        <omgdi:waypoint x="1305.0" y="210.0"/>
        <omgdi:waypoint x="1305.0" y="285.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f9" bpmnElement="f9">
        <omgdi:waypoint x="1255.0" y="325.0"/>
        <omgdi:waypoint x="1220.0" y="325.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f10" bpmnElement="f10">
        <omgdi:waypoint x="1170.0" y="285.0"/>
        <omgdi:waypoint x="1170.0" y="225.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f11" bpmnElement="f11">
        <omgdi:waypoint x="1490.0" y="185.0"/>
        <omgdi:waypoint x="1540.0" y="185.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
